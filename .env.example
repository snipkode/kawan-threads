APP_ENV=development
PORT=8080

# Datastore: "file" = local JSON file (dev/demo, no credentials needed),
#            "firebase" = Firebase Realtime Database (production).
# LOCKED — env only, not editable via the UI.
DATA_STORE=file
DATA_FILE=data/db.json

# LOCKED — env only, not editable via the UI.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# RUNTIME — enviable sebagai nilai awal, selanjutnya bisa diubah lewat
# UI (GET/PUT /api/settings) dan tersimpan di datastore.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_INTERVAL_MINUTES=5

AUTO_APPROVAL=false
AUTO_PUBLISH=false

MAX_POSTS_PER_DAY=5
MIN_POST_INTERVAL_MINUTES=90

EXPLORATION_RATE=0.20
MAX_RETRY=3

# Frontend (non-secret — safe to commit)
VITE_API_BASE_URL=http://localhost:8080